/// Business profiles for service providers
model Business {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  businessNameKey        String    @map("business_name_key") @db.VarChar(255) // Translation key for multilingual names
  businessDescriptionKey String?   @map("business_description_key") @db.VarChar(255) // Translation key for multilingual descriptions
  categoryId             String?   @map("category_id") @db.Uuid
  verified               Boolean   @default(false)
  active                 Boolean   @default(true)
  approved               Boolean   @default(false) // Admin approval for business owners
  approvedBy             String?   @map("approved_by") @db.Uuid // Admin who approved
  approvedAt             DateTime? @map("approved_at") @db.Timestamptz(6) // When it was approved
  avgRating              Decimal   @default(0) @map("avg_rating") @db.Decimal(3, 2)
  favoriteCount          Int       @default(0) @map("favorite_count") // Number of users who favorited this business
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  user                 User                  @relation(fields: [userId], references: [id])
  category             Category?             @relation(fields: [categoryId], references: [id])
  vouchers             Voucher[]             // Vouchers created by this business
  scans                VoucherScan[]         // Scans that happened at this business location
  fraudCases           FraudCase[]           // Fraud cases involving this business
  businessRegistration BusinessRegistration? // Registration data (one-time use)
  businessDetails      BusinessDetails?      // Additional business information
  primaryBusinessUsers User[]                @relation("UserPrimaryBusiness") // Users who have this as their primary business
  favoritedBy          FavouriteBusiness[]   // Users who favorited this business

  @@index([userId])
  @@index([categoryId])
  @@index([verified, active])
  @@index([avgRating])
  @@index([favoriteCount(sort: Desc)])
  @@index([deletedAt])
  @@map("businesses")
  @@schema("business")
}