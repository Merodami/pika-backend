{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "description": "Universally Unique Identifier",
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "userId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "stripePaymentMethodId": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "card",
        "bankAccount",
        "applePay",
        "googlePay",
        "wallet"
      ]
    },
    "isDefault": {
      "default": false,
      "type": "boolean"
    },
    "card": {
      "type": "object",
      "properties": {
        "brand": {
          "type": "string",
          "enum": [
            "visa",
            "mastercard",
            "amex",
            "discover",
            "diners",
            "jcb",
            "unionpay",
            "unknown"
          ]
        },
        "last4": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4
        },
        "expMonth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "expYear": {
          "type": "integer",
          "minimum": 2025,
          "maximum": 9007199254740991
        },
        "holderName": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "funding": {
          "type": "string",
          "enum": [
            "credit",
            "debit",
            "prepaid",
            "unknown"
          ]
        }
      },
      "required": [
        "brand",
        "last4",
        "expMonth",
        "expYear"
      ],
      "additionalProperties": false
    },
    "bankAccount": {
      "type": "object",
      "properties": {
        "bankName": {
          "type": "string"
        },
        "last4": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4
        },
        "accountHolderName": {
          "type": "string"
        },
        "accountHolderType": {
          "type": "string",
          "enum": [
            "individual",
            "company"
          ]
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      },
      "required": [
        "last4",
        "accountHolderName",
        "accountHolderType",
        "country",
        "currency"
      ],
      "additionalProperties": false
    },
    "wallet": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "applePay",
            "googlePay",
            "samsungPay"
          ]
        },
        "dynamicLast4": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "billingAddress": {
      "type": "object",
      "properties": {
        "line1": {
          "type": "string"
        },
        "line2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "createdAt": {
      "description": "When the record was created",
      "type": "string"
    },
    "updatedAt": {
      "description": "When the record was last updated",
      "type": "string"
    }
  },
  "required": [
    "id",
    "userId",
    "stripePaymentMethodId",
    "type",
    "isDefault",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}