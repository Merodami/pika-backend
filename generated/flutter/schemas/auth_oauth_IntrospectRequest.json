{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "token": {
      "description": "Token to validate",
      "type": "string",
      "minLength": 1
    },
    "tokenTypeHint": {
      "type": "string",
      "enum": [
        "accessToken",
        "refreshToken"
      ]
    }
  },
  "required": [
    "token"
  ],
  "additionalProperties": false
}