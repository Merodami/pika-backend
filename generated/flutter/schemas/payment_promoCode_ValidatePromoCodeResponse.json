{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "code": {
      "type": "string"
    },
    "discount": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "reason": {
      "description": "Reason if invalid",
      "type": "string"
    },
    "expiresAt": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    },
    "remainingUses": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": ["valid", "code"],
  "additionalProperties": false
}
