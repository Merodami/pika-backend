{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Support_commentTypes",
  "type": "object",
  "properties": {
    "CreateSupportCommentRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "problemId": {
          "description": "Universally Unique Identifier",
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        }
      },
      "required": ["problemId", "content"],
      "additionalProperties": false
    },
    "SupportCommentListResponse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Paginated response",
      "type": "object",
      "properties": {
        "data": {
          "description": "Page items",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "description": "Universally Unique Identifier",
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "problemId": {
                "description": "Universally Unique Identifier",
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "userId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "content": {
                "type": "string"
              },
              "isInternal": {
                "default": false,
                "type": "boolean"
              },
              "createdAt": {
                "description": "When the record was created",
                "type": "string"
              },
              "updatedAt": {
                "description": "When the record was last updated",
                "type": "string"
              }
            },
            "required": [
              "id",
              "problemId",
              "userId",
              "content",
              "isInternal",
              "createdAt",
              "updatedAt"
            ],
            "additionalProperties": false
          }
        },
        "pagination": {
          "type": "object",
          "properties": {
            "page": {
              "description": "Current page number",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "limit": {
              "description": "Items per page",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "total": {
              "description": "Total number of items",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "totalPages": {
              "description": "Total number of pages",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "hasNext": {
              "description": "Whether there is a next page",
              "type": "boolean"
            },
            "hasPrev": {
              "description": "Whether there is a previous page",
              "type": "boolean"
            }
          },
          "required": [
            "page",
            "limit",
            "total",
            "totalPages",
            "hasNext",
            "hasPrev"
          ],
          "additionalProperties": false
        }
      },
      "required": ["data", "pagination"],
      "additionalProperties": false
    },
    "SupportCommentResponse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "id": {
          "description": "Universally Unique Identifier",
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "problemId": {
          "description": "Universally Unique Identifier",
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "userId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "content": {
          "type": "string"
        },
        "isInternal": {
          "default": false,
          "type": "boolean"
        },
        "createdAt": {
          "description": "When the record was created",
          "type": "string"
        },
        "updatedAt": {
          "description": "When the record was last updated",
          "type": "string"
        }
      },
      "required": [
        "id",
        "problemId",
        "userId",
        "content",
        "isInternal",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "SupportCommentSearchParams": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "page": {
          "description": "Page number",
          "default": 1,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "description": "Items per page",
          "default": 20,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "sortBy": {
          "default": "createdAt",
          "type": "string",
          "enum": ["createdAt", "updatedAt"]
        },
        "sortOrder": {
          "default": "asc",
          "type": "string",
          "enum": ["asc", "desc"]
        },
        "search": {
          "description": "Search query",
          "type": "string"
        }
      },
      "required": ["page", "limit", "sortBy", "sortOrder"],
      "additionalProperties": false
    },
    "UpdateSupportCommentRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        }
      },
      "required": ["content"],
      "additionalProperties": false
    }
  }
}
