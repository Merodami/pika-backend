              },
              "sentAt": {
                "description": "ISO 8601 datetime with timezone",
                "type": "string"
              },
              "deliveredAt": {
                "description": "ISO 8601 datetime with timezone",
                "type": "string"
              },
              "openedAt": {
                "description": "ISO 8601 datetime with timezone",
                "type": "string"
              },
              "clickedAt": {
                "description": "ISO 8601 datetime with timezone",
                "type": "string"
              },
