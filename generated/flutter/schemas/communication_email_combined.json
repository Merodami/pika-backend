      "type": "object",
      "properties": {
        "to": {
          "description": "Primary recipient(s)",
          "anyOf": [
            {},
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "email": {},
                  "name": {
                    "type": "string",
                    "maxLength": 255
