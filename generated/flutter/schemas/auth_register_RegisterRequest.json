{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "password": {
      "description": "Password must meet security requirements",
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "allOf": [
        {
          "type": "string",
          "pattern": "[a-z]"
        },
        {
          "type": "string",
          "pattern": "[A-Z]"
        },
        {
          "type": "string",
          "pattern": "\\d"
        }
      ]
    },
    "firstName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^[a-zA-Z\\s\\-']+$"
    },
    "lastName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^[a-zA-Z\\s\\-']+$"
    },
    "phoneNumber": {
      "description": "Phone number in E.164 format",
      "type": "string",
      "pattern": "^\\+[1-9]\\d{1,14}$"
    },
    "dateOfBirth": {
      "description": "Date of birth in YYYY-MM-DD format",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "acceptTerms": {
      "description": "User must accept terms and conditions",
      "type": "boolean",
      "const": true
    },
    "marketingConsent": {
      "description": "User consent for marketing emails",
      "default": false,
      "type": "boolean"
    },
    "registrationSource": {
      "description": "Source of registration to determine user role",
      "default": "public",
      "type": "string",
      "enum": [
        "public",
        "adminDashboard"
      ]
    }
  },
  "required": [
    "email",
    "password",
    "firstName",
    "lastName",
    "acceptTerms",
    "marketingConsent",
    "registrationSource"
  ],
  "additionalProperties": false
}