{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Paginated response",
  "type": "object",
  "properties": {
    "data": {
      "description": "Page items",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Stripe product ID",
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "active": {
            "default": true,
            "type": "boolean"
          },
          "metadata": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "type": {
            "type": "string",
            "enum": ["membership", "merchandise", "service", "other"]
          },
          "createdAt": {
            "description": "When the record was created",
            "type": "string"
          },
          "updatedAt": {
            "description": "When the record was last updated",
            "type": "string"
          }
        },
        "required": ["id", "name", "active", "createdAt", "updatedAt"],
        "additionalProperties": false
      }
    },
    "pagination": {
      "type": "object",
      "properties": {
        "page": {
          "description": "Current page number",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "description": "Items per page",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "total": {
          "description": "Total number of items",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalPages": {
          "description": "Total number of pages",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hasNext": {
          "description": "Whether there is a next page",
          "type": "boolean"
        },
        "hasPrev": {
          "description": "Whether there is a previous page",
          "type": "boolean"
        }
      },
      "required": [
        "page",
        "limit",
        "total",
        "totalPages",
        "hasNext",
        "hasPrev"
      ],
      "additionalProperties": false
    }
  },
  "required": ["data", "pagination"],
  "additionalProperties": false
}
