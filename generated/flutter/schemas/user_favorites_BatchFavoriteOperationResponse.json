{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "added": {
      "description": "Number of items added",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "removed": {
      "description": "Number of items removed",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "errors": {
      "description": "List of errors if any operations failed",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": {
            "description": "ID of the item that failed",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "operation": {
            "description": "Operation that failed",
            "type": "string",
            "enum": ["add", "remove"]
          },
          "error": {
            "description": "Error message",
            "type": "string"
          }
        },
        "required": ["itemId", "operation", "error"],
        "additionalProperties": false
      }
    }
  },
  "required": ["added", "removed", "errors"],
  "additionalProperties": false
}
