{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "isValid": {
      "type": "boolean"
    },
    "standardized": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "street2": {
          "description": "Apartment, suite, etc.",
          "type": "string",
          "maxLength": 255
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "state": {
          "description": "State or province",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "postalCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "country": {
          "description": "ISO 3166-1 alpha-2 country code",
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "coordinates": {
          "description": "Optional geo coordinates",
          "type": "object",
          "properties": {
            "lat": {
              "description": "Latitude",
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lng": {
              "description": "Longitude",
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": ["lat", "lng"],
          "additionalProperties": false
        }
      },
      "required": ["street", "city", "state", "postalCode", "country"],
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "original": {
            "type": "string"
          },
          "suggested": {
            "type": "string"
          }
        },
        "required": ["field", "original", "suggested"],
        "additionalProperties": false
      }
    },
    "coordinates": {
      "type": "object",
      "properties": {
        "lat": {
          "description": "Latitude",
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "description": "Longitude",
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": ["lat", "lng"],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["isValid"],
  "additionalProperties": false
}
