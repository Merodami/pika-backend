{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "discount": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "active": {
      "type": "boolean"
    },
    "allowedTimes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "amountAvailable": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expirationDate": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    }
  },
  "additionalProperties": false
}
