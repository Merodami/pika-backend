{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "active": {
      "type": "boolean"
    },
    "type": {
      "type": "string",
      "enum": ["membership", "merchandise", "service", "other"]
    },
    "page": {
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "default": 20,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 100
    }
  },
  "required": ["page", "limit"],
  "additionalProperties": false
}
