{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "provider": {
      "description": "Social provider to link",
      "type": "string",
      "enum": [
        "google",
        "facebook",
        "apple"
      ]
    },
    "idToken": {
      "description": "Firebase ID token from provider",
      "type": "string",
      "minLength": 1
    },
    "replace": {
      "description": "Replace existing linked account",
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "provider",
    "idToken",
    "replace"
  ],
  "additionalProperties": false
}