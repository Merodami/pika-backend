              "updatedAt": {
                "description": "When the record was last updated",
                "type": "string"
              }
            },
            "required": [
              "id",
              "userId",
              "fileKey",
              "fileName",
              "fileSize",
              "mimeType",
              "fileType",
              "status",
              "provider",
              "createdAt",
              "updatedAt"
            ],
            "additionalProperties": false
          }
        },
        "pagination": {
          "type": "object",
          "properties": {
            "page": {
              "description": "Current page number",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "limit": {
              "description": "Items per page",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "total": {
              "description": "Total number of items",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "totalPages": {
              "description": "Total number of pages",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "hasNext": {
              "description": "Whether there is a next page",
              "type": "boolean"
            },
            "hasPrev": {
              "description": "Whether there is a previous page",
              "type": "boolean"
            }
          },
          "required": [
            "page",
            "limit",
            "total",
            "totalPages",
            "hasNext",
            "hasPrev"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "data",
        "pagination"
      ],
      "additionalProperties": false
