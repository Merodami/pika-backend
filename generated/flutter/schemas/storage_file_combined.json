              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "uploaded",
                  "processing",
                  "processed",
                  "failed",
                  "deleted"
                ]
              },
              "provider": {
                "type": "string",
                "enum": [
                  "awsS3",
                  "local",
                  "minio"
                ]
              },
              "bucketName": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "uploadedAt": {
                "description": "ISO 8601 datetime with timezone",
                "type": "string"
              },
              "deletedAt": {
                "description": "ISO 8601 datetime with timezone",
                "type": "string"
              },
              "metadata": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "error": {
                "type": "string"
              },
              "createdAt": {
                "description": "When the record was created",
                "type": "string"
