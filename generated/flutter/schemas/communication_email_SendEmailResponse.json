{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "messageId": {
      "description": "Unique identifier for the email",
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "sent",
        "delivered",
        "failed",
        "bounced",
        "complained",
        "rejected"
      ]
    },
    "queuedAt": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    },
    "scheduledAt": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    }
  },
  "required": ["messageId", "status"],
  "additionalProperties": false
}
