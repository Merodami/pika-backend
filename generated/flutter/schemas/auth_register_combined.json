{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Auth_registerTypes",
  "type": "object",
  "properties": {
    "RegisterRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "description": "Password must meet security requirements",
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "allOf": [
            {
              "type": "string",
              "pattern": "[a-z]"
            },
            {
              "type": "string",
              "pattern": "[A-Z]"
            },
            {
              "type": "string",
              "pattern": "\\d"
            }
          ]
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[a-zA-Z\\s\\-']+$"
        },
        "lastName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[a-zA-Z\\s\\-']+$"
        },
        "phoneNumber": {
          "description": "Phone number in E.164 format",
          "type": "string",
          "pattern": "^\\+[1-9]\\d{1,14}$"
        },
        "dateOfBirth": {
          "description": "Date of birth in YYYY-MM-DD format",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "acceptTerms": {
          "description": "User must accept terms and conditions",
          "type": "boolean",
          "const": true
        },
        "marketingConsent": {
          "description": "User consent for marketing emails",
          "default": false,
          "type": "boolean"
        },
        "registrationSource": {
          "description": "Source of registration to determine user role",
          "default": "public",
          "type": "string",
          "enum": ["public", "adminDashboard"]
        }
      },
      "required": [
        "email",
        "password",
        "firstName",
        "lastName",
        "acceptTerms",
        "marketingConsent",
        "registrationSource"
      ],
      "additionalProperties": false
    },
    "RegisterResponse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "message": {
          "default": "Registration successful. Please check your email to verify your account.",
          "type": "string"
        },
        "userId": {
          "description": "Newly created user ID",
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
        },
        "emailSent": {
          "description": "Whether verification email was sent successfully",
          "type": "boolean"
        }
      },
      "required": ["message", "userId", "emailSent"],
      "additionalProperties": false
    },
    "ResendVerificationRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        }
      },
      "required": ["email"],
      "additionalProperties": false
    },
    "ResendVerificationResponse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "message": {
          "default": "If an account exists with this email, a verification link has been sent.",
          "type": "string"
        }
      },
      "required": ["message"],
      "additionalProperties": false
    },
    "VerifyEmailRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "token": {
          "description": "Email verification token from email link",
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["token"],
      "additionalProperties": false
    },
    "VerifyEmailResponse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "message": {
          "default": "Email verified successfully",
          "type": "string"
        },
        "emailVerified": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": ["message", "emailVerified"],
      "additionalProperties": false
    }
  }
}
