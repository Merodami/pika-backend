{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": ["invalidSignature", "processingError", "unknownEventType"]
        },
        "message": {
          "type": "string"
        },
        "eventId": {
          "type": "string"
        },
        "timestamp": {
          "description": "ISO 8601 datetime with timezone",
          "type": "string"
        }
      },
      "required": ["code", "message", "timestamp"],
      "additionalProperties": false
    }
  },
  "required": ["error"],
  "additionalProperties": false
}
