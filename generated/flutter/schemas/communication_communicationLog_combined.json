                "type": "string"
              },
              "referenceId": {
                "type": "string"
              },
              "referenceType": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "metadata": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
