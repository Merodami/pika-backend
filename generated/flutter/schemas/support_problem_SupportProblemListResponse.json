{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Paginated response",
  "type": "object",
  "properties": {
    "data": {
      "description": "Page items",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Universally Unique Identifier",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "ticketNumber": {
            "type": "string"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "assigned",
              "inProgress",
              "waitingCustomer",
              "waitingInternal",
              "resolved",
              "closed"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "urgent",
              "critical"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "billing",
              "technical",
              "account",
              "general",
              "bugReport",
              "featureRequest"
            ]
          },
          "resolvedAt": {
            "description": "ISO 8601 datetime with timezone",
            "type": "string"
          },
          "assignedTo": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "files": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "description": "When the record was created",
            "type": "string"
          },
          "updatedAt": {
            "description": "When the record was last updated",
            "type": "string"
          }
        },
        "required": [
          "id",
          "userId",
          "title",
          "description",
          "status",
          "priority",
          "type",
          "files",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    },
    "pagination": {
      "type": "object",
      "properties": {
        "page": {
          "description": "Current page number",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "description": "Items per page",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "total": {
          "description": "Total number of items",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalPages": {
          "description": "Total number of pages",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hasNext": {
          "description": "Whether there is a next page",
          "type": "boolean"
        },
        "hasPrev": {
          "description": "Whether there is a previous page",
          "type": "boolean"
        }
      },
      "required": [
        "page",
        "limit",
        "total",
        "totalPages",
        "hasNext",
        "hasPrev"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "data",
    "pagination"
  ],
  "additionalProperties": false
}