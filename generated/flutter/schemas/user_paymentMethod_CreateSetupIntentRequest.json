{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "paymentMethodTypes": {
      "default": ["card"],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "usage": {
      "default": "off_session",
      "type": "string",
      "enum": ["on_session", "off_session"]
    }
