{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "amountDue": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "dueDate": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    },
    "lineItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "description",
          "amount"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "amountDue",
    "currency",
    "dueDate",
    "lineItems"
  ],
  "additionalProperties": false
}