{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "scanSource": {
      "type": "string",
      "enum": [
        "camera",
        "gallery",
        "link",
        "share"
      ]
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "description": "Latitude",
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "description": "Longitude",
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "lat",
        "lng"
      ],
      "additionalProperties": false
    },
    "deviceInfo": {
      "type": "object",
      "properties": {
        "userAgent": {
          "type": "string"
        },
        "platform": {
          "type": "string",
          "enum": [
            "ios",
            "android",
            "web",
            "desktop",
            "other"
          ]
        },
        "appVersion": {
          "type": "string"
        },
        "deviceId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}