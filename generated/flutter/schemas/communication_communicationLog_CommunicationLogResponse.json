{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "description": "Universally Unique Identifier",
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "channel": {
      "type": "string",
      "enum": ["email", "sms", "push", "inApp", "webhook"]
    },
    "direction": {
      "type": "string",
      "enum": ["inbound", "outbound"]
    },
    "status": {
      "type": "string",
      "enum": ["pending", "queued", "sent", "delivered", "failed", "cancelled"]
    },
    "userId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "recipient": {
      "description": "Email, phone, or device ID",
      "type": "string"
    },
    "sender": {
      "type": "string"
    },
    "subject": {
      "type": "string",
      "maxLength": 255
    },
    "templateId": {
      "description": "Universally Unique Identifier",
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "templateName": {
      "type": "string"
    },
    "content": {
      "description": "Truncated content preview",
      "type": "string"
    },
    "messageId": {
      "description": "External message ID",
      "type": "string"
    },
    "conversationId": {
      "description": "Thread/conversation ID",
      "type": "string"
    },
    "referenceId": {
      "description": "Related entity ID",
      "type": "string"
    },
    "referenceType": {
      "description": "Related entity type",
      "type": "string"
    },
    "sentAt": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    },
    "deliveredAt": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    },
    "openedAt": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    },
    "clickedAt": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    },
    "failedAt": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    },
    "errorCode": {
      "type": "string"
    },
    "errorMessage": {
      "type": "string"
    },
    "bounceType": {
      "type": "string",
      "enum": ["soft", "hard"]
    },
    "openCount": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "clickCount": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "provider": {
      "description": "Email/SMS provider",
      "type": "string"
    },
    "cost": {
      "description": "Cost in cents",
      "type": "number",
      "minimum": 0
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "description": "When the record was created",
      "type": "string"
    },
    "updatedAt": {
      "description": "When the record was last updated",
      "type": "string"
    }
  },
  "required": [
    "id",
    "channel",
    "direction",
    "status",
    "openCount",
    "clickCount",
    "tags",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
