{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "avatarUrl": {
      "description": "URL of the uploaded avatar",
      "type": "string",
      "format": "uri"
    },
    "message": {
      "default": "Avatar uploaded successfully",
      "type": "string"
    }
  },
  "required": [
    "avatarUrl",
    "message"
  ],
  "additionalProperties": false
}