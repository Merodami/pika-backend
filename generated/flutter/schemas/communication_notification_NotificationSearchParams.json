{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "page": {
      "description": "Page number",
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "description": "Items per page",
      "default": 20,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "sortBy": {
      "default": "createdAt",
      "type": "string",
      "enum": [
        "createdAt",
        "priority",
        "expiresAt"
      ]
    },
    "sortOrder": {
      "description": "Sort order",
      "default": "desc",
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "search": {
      "description": "Search query",
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "email",
        "inApp",
        "sms",
        "push"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "delivered",
        "failed",
        "read"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "isRead": {
      "type": "boolean"
    },
    "isGlobal": {
      "type": "boolean"
    },
    "category": {
      "type": "string"
    },
    "fromDate": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    },
    "toDate": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    }
  },
  "required": [
    "page",
    "limit",
    "sortBy",
    "sortOrder"
  ],
  "additionalProperties": false
}