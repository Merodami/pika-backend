{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "description": "Storage log ID",
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "fileId": {
      "description": "Universally Unique Identifier",
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "fileKey": {
      "type": "string"
    },
    "fileName": {
      "type": "string"
    },
    "fileSize": {
      "type": "number"
    },
    "mimeType": {
      "type": "string"
    },
    "fileType": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "document",
        "audio",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "uploaded",
        "processing",
        "processed",
        "failed",
        "deleted"
      ]
    },
    "provider": {
      "type": "string",
      "enum": [
        "awsS3",
        "local",
        "minio"
      ]
    },
    "url": {
      "description": "Presigned URL if applicable",
      "type": "string",
      "format": "uri"
    },
    "uploadedAt": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    },
    "metadata": {
      "description": "File metadata",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "required": [
    "id",
    "fileId",
    "fileKey",
    "fileName",
    "fileSize",
    "mimeType",
    "fileType",
    "status",
    "provider",
    "uploadedAt"
  ],
  "additionalProperties": false
}