{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "payload": {
      "description": "Raw webhook payload",
      "type": "string"
    },
    "signature": {
      "description": "Stripe signature header",
      "type": "string"
    },
    "timestamp": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "payload",
    "signature"
  ],
  "additionalProperties": false
}