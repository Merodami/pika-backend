{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "page": {
      "description": "Page number",
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "description": "Items per page",
      "default": 20,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "sortBy": {
      "default": "publishedAt",
      "type": "string",
      "enum": [
        "createdAt",
        "updatedAt",
        "title",
        "year",
        "month",
        "status",
        "publishedAt"
      ]
    },
    "sortOrder": {
      "description": "Sort order",
      "default": "desc",
      "type": "string",
      "enum": ["asc", "desc"]
    },
    "search": {
      "description": "Search in title and edition",
      "type": "string"
    },
    "bookType": {
      "type": "string",
      "enum": [
        "monthly",
        "specialEdition",
        "regional",
        "seasonal",
        "promotional"
      ]
    },
    "year": {
      "description": "Filter by year",
      "type": "integer",
      "minimum": 2020,
      "maximum": 2100
    },
    "month": {
      "description": "Filter by month",
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    }
  },
  "required": ["page", "limit", "sortBy", "sortOrder"],
  "additionalProperties": false
}
