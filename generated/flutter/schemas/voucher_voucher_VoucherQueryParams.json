{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "page": {
      "description": "Page number",
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "description": "Items per page",
      "default": 20,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "sortBy": {
      "default": "createdAt",
      "type": "string",
      "enum": [
        "createdAt",
        "updatedAt",
        "expiresAt",
        "discountValue",
        "title"
      ]
    },
    "sortOrder": {
      "description": "Sort order",
      "default": "desc",
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "search": {
      "description": "Search query",
      "type": "string"
    },
    "businessId": {
      "description": "Filter by business ID",
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "categoryId": {
      "description": "Filter by category ID",
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "state": {
      "description": "Filter by voucher state",
      "type": "string",
      "enum": [
        "draft",
        "published",
        "claimed",
        "redeemed",
        "expired",
        "suspended"
      ]
    },
    "discountType": {
      "description": "Filter by discount type",
      "type": "string",
      "enum": [
        "fixed",
        "percentage"
      ]
    },
    "minDiscount": {
      "description": "Minimum discount value",
      "type": "number",
      "minimum": 0
    },
    "maxDiscount": {
      "description": "Maximum discount value",
      "type": "number",
      "minimum": 0
    },
    "minValue": {
      "description": "Minimum voucher value",
      "type": "number",
      "minimum": 0
    },
    "maxValue": {
      "description": "Maximum voucher value",
      "type": "number",
      "minimum": 0
    },
    "type": {
      "description": "Voucher type filter",
      "type": "string"
    },
    "currency": {
      "description": "Filter by currency",
      "type": "string"
    },
    "validFrom": {
      "description": "Valid from date filter",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "validUntil": {
      "description": "Valid until date filter",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "include": {
      "description": "Comma-separated relations to include",
      "type": "string"
    },
    "hasAvailableUses": {
      "description": "Filter vouchers with available uses",
      "type": "boolean"
    },
    "lat": {
      "description": "Search center latitude",
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lng": {
      "description": "Search center longitude",
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "radius": {
      "description": "Search radius in kilometers",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "isActive": {
      "description": "Filter by active status",
      "type": "boolean"
    },
    "isExpired": {
      "description": "Filter by expired status",
      "type": "boolean"
    },
    "hasLocation": {
      "description": "Filter vouchers with location",
      "type": "boolean"
    },
    "hasImage": {
      "description": "Filter vouchers with image",
      "type": "boolean"
    }
  },
  "required": [
    "page",
    "limit",
    "sortBy",
    "sortOrder"
  ],
  "additionalProperties": false
}