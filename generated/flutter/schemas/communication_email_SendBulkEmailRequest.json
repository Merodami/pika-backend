{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "recipients": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "variables": {
            "description": "Recipient-specific template variables",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "metadata": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": false
      }
    },
    "subject": {
      "type": "string",
      "maxLength": 255
    },
    "templateId": {
      "description": "Template ID for bulk emails",
      "type": "string"
    },
    "globalVariables": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "priority": {
      "default": "normal",
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "trackOpens": {
      "default": true,
      "type": "boolean"
    },
    "trackClicks": {
      "default": true,
      "type": "boolean"
    },
    "scheduledAt": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    },
    "batchSize": {
      "default": 50,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "delayBetweenBatches": {
      "description": "Delay in milliseconds",
      "default": 1000,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "recipients",
    "subject",
    "templateId",
    "priority",
    "trackOpens",
    "trackClicks",
    "batchSize",
    "delayBetweenBatches"
  ],
  "additionalProperties": false
}