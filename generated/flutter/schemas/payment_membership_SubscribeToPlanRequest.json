{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "planType": {
      "type": "string",
      "enum": ["basic", "premium", "enterprise", "trial"]
    },
    "paymentMethodId": {
      "description": "Stripe payment method ID",
      "type": "string"
    },
    "couponCode": {
      "type": "string"
    }
  },
  "required": ["planType", "paymentMethodId"],
  "additionalProperties": false
}
