{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Universally Unique Identifier",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "street": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "street2": {
            "description": "Apartment, suite, etc.",
            "type": "string",
            "maxLength": 255
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "state": {
            "description": "State or province",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "postalCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "country": {
            "description": "ISO 3166-1 alpha-2 country code",
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "coordinates": {
            "description": "Optional geo coordinates",
            "type": "object",
            "properties": {
              "lat": {
                "description": "Latitude",
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lng": {
                "description": "Longitude",
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "lat",
              "lng"
            ],
            "additionalProperties": false
          },
          "type": {
            "type": "string",
            "enum": [
              "home",
              "work",
              "billing",
              "shipping",
              "other"
            ]
          },
          "label": {
            "description": "Custom label",
            "type": "string",
            "maxLength": 100
          },
          "isDefault": {
            "default": false,
            "type": "boolean"
          },
          "isPrimary": {
            "default": false,
            "type": "boolean"
          },
          "isVerified": {
            "default": false,
            "type": "boolean"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "instructions": {
            "description": "Delivery instructions",
            "type": "string",
            "maxLength": 500
          },
          "accessCode": {
            "type": "string",
            "maxLength": 50
          },
          "createdAt": {
            "description": "When the record was created",
            "type": "string"
          },
          "updatedAt": {
            "description": "When the record was last updated",
            "type": "string"
          }
        },
        "required": [
          "id",
          "userId",
          "street",
          "city",
          "state",
          "postalCode",
          "country",
          "type",
          "isDefault",
          "isPrimary",
          "isVerified",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "page": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "hasMore": {
      "type": "boolean"
    }
  },
  "required": [
    "data",
    "total",
    "page",
    "limit",
    "hasMore"
  ],
  "additionalProperties": false
}