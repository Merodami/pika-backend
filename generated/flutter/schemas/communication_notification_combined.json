        "pagination": {
          "type": "object",
          "properties": {
            "page": {
              "description": "Current page number",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "limit": {
              "description": "Items per page",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100
