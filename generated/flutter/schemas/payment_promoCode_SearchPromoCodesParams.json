{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "expired": {
      "type": "boolean"
    },
    "createdBy": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "page": {
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "default": 20,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 50
    },
    "sort": {
      "type": "string",
      "enum": ["code", "discount", "expirationDate", "createdAt"]
    },
    "order": {
      "default": "desc",
      "type": "string",
      "enum": ["asc", "desc"]
    }
  },
  "required": ["page", "limit", "order"],
  "additionalProperties": false
}
