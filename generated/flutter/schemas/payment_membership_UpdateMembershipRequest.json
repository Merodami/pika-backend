{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "stripeCustomerId": {
      "type": "string"
    },
    "stripeSubscriptionId": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "subscriptionStatus": {
      "type": "string",
      "enum": [
        "active",
        "pastDue",
        "canceled",
        "incomplete",
        "incompleteExpired",
        "trialing",
        "unpaid"
      ]
    },
    "planType": {
      "type": "string",
      "enum": [
        "basic",
        "premium",
        "enterprise",
        "trial"
      ]
    },
    "lastPaymentDate": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    },
    "currentPeriodStart": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    },
    "currentPeriodEnd": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    },
    "cancelAtPeriodEnd": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}