{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "description": "Universally Unique Identifier",
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
    },
    "userId": {
      "description": "User who owns this business",
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
    },
    "businessName": {
      "description": "Business name in requested language",
      "type": "string",
      "maxLength": 200
    },
    "businessDescription": {
      "description": "Business description in requested language",
      "type": "string",
      "maxLength": 2000
    },
    "categoryId": {
      "description": "Category this business belongs to",
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
    },
    "verified": {
      "description": "Whether business is verified",
      "default": false,
      "type": "boolean"
    },
    "active": {
      "description": "Whether business is active",
      "default": true,
      "type": "boolean"
    },
    "approved": {
      "description": "Whether business is approved by admin",
      "default": false,
      "type": "boolean"
    },
    "avgRating": {
      "description": "Average rating of the business",
      "default": 0,
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "user": {
      "description": "Business owner profile when ?include=user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
        },
        "firstName": {
          "type": "string",
          "maxLength": 50
        },
        "lastName": {
          "type": "string",
          "maxLength": 50
        },
        "avatarUrl": {
          "type": "string",
          "format": "uri"
        },
        "createdAt": {
          "description": "ISO 8601 datetime with timezone",
          "type": "string"
        }
      },
      "required": ["id", "firstName", "lastName", "createdAt"],
      "additionalProperties": false
    },
    "category": {
      "description": "Category information when ?include=category",
      "type": "object",
      "properties": {
        "id": {
          "description": "Universally Unique Identifier",
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
        },
        "name": {
          "description": "Category name in requested language",
          "type": "string"
        },
        "description": {
          "description": "Category description in requested language",
          "type": "string"
        },
        "icon": {
          "description": "Category icon identifier",
          "type": "string",
          "maxLength": 255
        },
        "parentId": {
          "description": "Parent category ID for hierarchical structure",
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
        },
        "isActive": {
          "description": "Whether category is active",
          "default": true,
          "type": "boolean"
        },
        "sortOrder": {
          "description": "Sort order for display",
          "default": 0,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "slug": {
          "description": "URL-friendly category identifier",
          "type": "string",
          "maxLength": 255
        },
        "level": {
          "description": "Hierarchy level (1 for root, 2+ for children)",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "path": {
          "description": "Hierarchical path using parent IDs",
          "type": "string"
        },
        "createdBy": {
          "description": "User who created the category",
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
        },
        "updatedBy": {
          "description": "User who last updated the category",
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
        },
        "createdAt": {
          "description": "When the record was created",
          "type": "string"
        },
        "updatedAt": {
          "description": "When the record was last updated",
          "type": "string"
        },
        "children": {
          "description": "Child categories for hierarchical display",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "description": "Universally Unique Identifier",
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
              },
              "name": {
                "description": "Category name in requested language",
                "type": "string"
              },
              "description": {
                "description": "Category description in requested language",
                "type": "string"
              },
              "icon": {
                "description": "Category icon identifier",
                "type": "string",
                "maxLength": 255
              },
              "parentId": {
                "description": "Parent category ID for hierarchical structure",
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
              },
              "isActive": {
                "description": "Whether category is active",
                "default": true,
                "type": "boolean"
              },
              "sortOrder": {
                "description": "Sort order for display",
                "default": 0,
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "slug": {
                "description": "URL-friendly category identifier",
                "type": "string",
                "maxLength": 255
              },
              "level": {
                "description": "Hierarchy level (1 for root, 2+ for children)",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "path": {
                "description": "Hierarchical path using parent IDs",
                "type": "string"
              },
              "createdBy": {
                "description": "User who created the category",
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
              },
              "updatedBy": {
                "description": "User who last updated the category",
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
              },
              "createdAt": {
                "description": "When the record was created",
                "type": "string"
              },
              "updatedAt": {
                "description": "When the record was last updated",
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "isActive",
              "sortOrder",
              "slug",
              "level",
              "path",
              "createdBy",
              "createdAt",
              "updatedAt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "name",
        "isActive",
        "sortOrder",
        "slug",
        "level",
        "path",
        "createdBy",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "description": "When the record was created",
      "type": "string"
    },
    "updatedAt": {
      "description": "When the record was last updated",
      "type": "string"
    }
  },
  "required": [
    "id",
    "userId",
    "businessName",
    "categoryId",
    "verified",
    "active",
    "approved",
    "avgRating",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
