{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "status": {
      "type": "string"
    },
    "folder": {
      "type": "string"
    },
    "contentType": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "fromDate": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    },
    "toDate": {
      "description": "ISO 8601 datetime with timezone",
      "type": "string"
    },
    "page": {
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "default": 20,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "sortBy": {
      "default": "uploadedAt",
      "type": "string",
      "enum": ["uploadedAt", "fileSize", "fileName", "createdAt", "updatedAt"]
    },
    "sortOrder": {
      "default": "desc",
      "type": "string",
      "enum": ["asc", "desc"]
    }
  },
  "required": ["page", "limit", "sortBy", "sortOrder"],
  "additionalProperties": false
}
