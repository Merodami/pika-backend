{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "urgent", "critical"]
    },
    "type": {
      "type": "string",
      "enum": [
        "billing",
        "technical",
        "account",
        "general",
        "bugReport",
        "featureRequest"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
