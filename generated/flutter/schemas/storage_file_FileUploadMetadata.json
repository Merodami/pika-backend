{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "tags": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "isPublic": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": ["isPublic"],
  "additionalProperties": false
}
