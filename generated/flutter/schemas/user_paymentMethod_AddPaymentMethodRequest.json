{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "stripePaymentMethodId": {
      "type": "string"
    },
    "makeDefault": {
      "type": "boolean"
    },
    "billingAddress": {
      "type": "object",
      "properties": {
        "line1": {
          "type": "string"
        },
        "line2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        }
      },
      "required": [
        "line1",
        "city",
        "state",
        "postalCode",
        "country"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "stripePaymentMethodId"
  ],
  "additionalProperties": false
}