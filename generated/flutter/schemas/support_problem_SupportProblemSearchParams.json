{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "page": {
      "description": "Page number",
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "description": "Items per page",
      "default": 20,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "sortBy": {
      "default": "createdAt",
      "type": "string",
      "enum": ["createdAt", "updatedAt", "priority", "status"]
    },
    "sortOrder": {
      "description": "Sort order",
      "default": "desc",
      "type": "string",
      "enum": ["asc", "desc"]
    },
    "search": {
      "description": "Search query",
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "assigned",
        "inProgress",
        "waitingCustomer",
        "waitingInternal",
        "resolved",
        "closed"
      ]
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "urgent", "critical"]
    },
    "type": {
      "type": "string",
      "enum": [
        "billing",
        "technical",
        "account",
        "general",
        "bugReport",
        "featureRequest"
      ]
    }
  },
  "required": ["page", "limit", "sortBy", "sortOrder"],
  "additionalProperties": false
}
