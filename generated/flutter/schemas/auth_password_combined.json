{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Auth_passwordTypes",
  "type": "object",
  "properties": {
    "ChangePasswordRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "currentPassword": {
          "description": "Current password for verification",
          "type": "string",
          "minLength": 1
        },
        "newPassword": {
          "description": "New password meeting security requirements",
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "allOf": [
            {
              "type": "string",
              "pattern": "[a-z]"
            },
            {
              "type": "string",
              "pattern": "[A-Z]"
            },
            {
              "type": "string",
              "pattern": "\\d"
            }
          ]
        }
      },
      "required": [
        "currentPassword",
        "newPassword"
      ],
      "additionalProperties": false
    },
    "ChangePasswordResponse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "message": {
          "default": "Password changed successfully",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    },
    "ForgotPasswordRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "additionalProperties": false
    },
    "ForgotPasswordResponse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "message": {
          "default": "If an account exists with this email, a password reset link has been sent.",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    },
    "ResetPasswordRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "token": {
          "description": "Password reset token from email",
          "type": "string",
          "minLength": 1
        },
        "newPassword": {
          "description": "New password meeting security requirements",
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "allOf": [
            {
              "type": "string",
              "pattern": "[a-z]"
            },
            {
              "type": "string",
              "pattern": "[A-Z]"
            },
            {
              "type": "string",
              "pattern": "\\d"
            }
          ]
        }
      },
      "required": [
        "token",
        "newPassword"
      ],
      "additionalProperties": false
    },
    "ResetPasswordResponse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "message": {
          "default": "Password reset successfully",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    }
  }
}