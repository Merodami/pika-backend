{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "page": {
      "description": "Page number",
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "description": "Items per page",
      "default": 20,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "sortBy": {
      "default": "name",
      "type": "string",
      "enum": [
        "name",
        "price",
        "createdAt",
        "updatedAt"
      ]
    },
    "sortOrder": {
      "description": "Sort order",
      "default": "desc",
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "search": {
      "description": "Search query",
      "type": "string"
    },
    "isActive": {
      "type": "boolean"
    },
    "interval": {
      "type": "string",
      "enum": [
        "day",
        "week",
        "month",
        "year"
      ]
    },
    "planType": {
      "type": "string",
      "enum": [
        "basic",
        "premium",
        "enterprise",
        "trial"
      ]
    }
  },
  "required": [
    "page",
    "limit",
    "sortBy",
    "sortOrder"
  ],
  "additionalProperties": false
}