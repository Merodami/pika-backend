        "notifications": {
          "type": "object",
          "properties": {
            "email": {
              "type": "object",
              "properties": {
                "marketing": {
                  "default": false,
                  "type": "boolean"
                },
                "bookingReminders": {
                  "default": true,
                  "type": "boolean"
                },
                "sessionUpdates": {
