          "type": "string",
          "maxLength": 50
        },
        "lastName": {
          "type": "string",
          "maxLength": 50
        },
        "avatarUrl": {
          "type": "string",
          "format": "uri"
        },
        "createdAt": {
          "description": "ISO 8601 datetime with timezone",
          "type": "string"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "UpdatePreferencesRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "notifications": {
          "type": "object",
          "properties": {
            "email": {
              "type": "object",
              "properties": {
                "marketing": {
                  "type": "boolean"
                },
                "bookingReminders": {
                  "type": "boolean"
                },
                "sessionUpdates": {
                  "type": "boolean"
                },
                "friendRequests": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "push": {
              "type": "object",
              "properties": {
                "bookingReminders": {
                  "type": "boolean"
                },
                "sessionUpdates": {
                  "type": "boolean"
                },
                "friendRequests": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "privacy": {
          "type": "object",
          "properties": {
            "profileVisibility": {
              "type": "string",
              "enum": [
                "public",
                "friends",
                "private"
              ]
            },
            "showEmail": {
              "type": "boolean"
            },
            "showPhone": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "display": {
          "type": "object",
          "properties": {
            "theme": {
              "type": "string",
              "enum": [
                "light",
                "dark",
                "system"
              ]
            },
            "language": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2,
              "pattern": "^[a-z]{2}$"
            },
            "timezone": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "UpdateProfileRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
