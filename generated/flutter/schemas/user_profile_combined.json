              "firstName": {
                "type": "string",
                "maxLength": 50
              },
              "lastName": {
                "type": "string",
                "maxLength": 50
              },
              "avatarUrl": {
                "type": "string",
                "format": "uri"
              },
              "createdAt": {
                "description": "ISO 8601 datetime with timezone",
                "type": "string"
              }
            },
            "required": [
              "id",
              "firstName",
              "lastName",
              "createdAt"
            ],
            "additionalProperties": false
          }
        },
        "totalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "friends",
        "totalCount"
      ],
      "additionalProperties": false
