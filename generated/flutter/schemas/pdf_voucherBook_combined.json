              "description": "Month for monthly books (1-12)",
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "year": {
              "description": "Year of publication",
              "type": "integer",
              "minimum": 2020,
              "maximum": 2100
            },
            "status": {
              "description": "Only published books visible to public",
              "type": "string",
              "enum": ["published"]
            },
            "totalPages": {
              "description": "Total number of pages",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
