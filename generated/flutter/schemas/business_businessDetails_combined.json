{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Business_businessDetailsTypes",
  "type": "object",
  "properties": {
    "BusinessDetailsResponse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "id": {
          "description": "Universally Unique Identifier",
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "businessId": {
          "description": "Business ID this details belong to",
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "phone": {
          "description": "Business phone number",
          "type": "string",
          "maxLength": 20
        },
        "email": {
          "description": "Business email address",
          "type": "string",
          "maxLength": 255,
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "website": {
          "description": "Business website URL",
          "type": "string",
          "maxLength": 255,
          "format": "uri"
        },
        "logoUrl": {
          "description": "Business logo image URL",
          "type": "string",
          "maxLength": 512,
          "format": "uri"
        },
        "street": {
          "description": "Street address",
          "type": "string",
          "maxLength": 255
        },
        "city": {
          "description": "City",
          "type": "string",
          "maxLength": 100
        },
        "state": {
          "description": "State or province",
          "type": "string",
          "maxLength": 100
        },
        "postalCode": {
          "description": "Postal/ZIP code",
          "type": "string",
          "maxLength": 20
        },
        "country": {
          "description": "Country code (ISO 3166-1 alpha-2)",
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "operatingHours": {
          "description": "Operating hours schedule (JSON)",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "open": {
                "type": "string"
              },
              "close": {
                "type": "string"
              },
              "closed": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "socialMedia": {
          "description": "Social media links (JSON)",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalInfo": {
          "description": "Additional business information (JSON)",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "createdAt": {
          "description": "When the record was created",
          "type": "string"
        },
        "updatedAt": {
          "description": "When the record was last updated",
          "type": "string"
        }
      },
      "required": ["id", "businessId", "createdAt", "updatedAt"],
      "additionalProperties": false
    },
    "UpdateBusinessDetailsRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "phone": {
          "type": "string",
          "maxLength": 20
        },
        "email": {
          "type": "string",
          "maxLength": 255,
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "website": {
          "type": "string",
          "maxLength": 255,
          "format": "uri"
        },
        "logoUrl": {
          "type": "string",
          "maxLength": 512,
          "format": "uri"
        },
        "street": {
          "type": "string",
          "maxLength": 255
        },
        "city": {
          "type": "string",
          "maxLength": 100
        },
        "state": {
          "type": "string",
          "maxLength": 100
        },
        "postalCode": {
          "type": "string",
          "maxLength": 20
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "operatingHours": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "open": {
                "type": "string"
              },
              "close": {
                "type": "string"
              },
              "closed": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "socialMedia": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalInfo": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "UploadBusinessLogoResponse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "logoUrl": {
          "description": "URL of the uploaded business logo",
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["logoUrl"],
      "additionalProperties": false
    }
  }
}
