{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "description": "Universally Unique Identifier",
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "title": {
      "description": "Voucher book title",
      "type": "string",
      "maxLength": 255
    },
    "edition": {
      "description": "Book edition (e.g., \"January 2024\")",
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "bookType": {
      "type": "string",
      "enum": [
        "monthly",
        "specialEdition",
        "regional",
        "seasonal",
        "promotional"
      ]
    },
    "month": {
      "description": "Month for monthly books (1-12)",
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "year": {
      "description": "Year of publication",
      "type": "integer",
      "minimum": 2020,
      "maximum": 2100
    },
    "status": {
      "description": "Only published books visible to public",
      "type": "string",
      "enum": [
        "published"
      ]
    },
    "totalPages": {
      "description": "Total number of pages",
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "publishedAt": {
      "description": "When the book was published",
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "coverImageUrl": {
      "description": "URL of the cover image",
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "backImageUrl": {
      "description": "URL of the back cover image",
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "pdfUrl": {
      "description": "URL of the generated PDF",
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "description": "When the record was created",
      "type": "string"
    },
    "updatedAt": {
      "description": "When the record was last updated",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "bookType",
    "year",
    "status",
    "totalPages",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}