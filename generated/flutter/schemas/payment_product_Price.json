{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "description": "Stripe price ID",
      "type": "string"
    },
    "productId": {
      "type": "string"
    },
    "amount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currency": {
      "type": "string",
      "enum": ["PYG", "USD", "EUR", "GBP", "CAD", "AUD", "JPY", "CNY", "INR"]
    },
    "interval": {
      "type": "string",
      "enum": ["day", "week", "month", "year"]
    },
    "intervalCount": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "active": {
      "default": true,
      "type": "boolean"
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "createdAt": {
      "description": "When the record was created",
      "type": "string"
    },
    "updatedAt": {
      "description": "When the record was last updated",
      "type": "string"
    }
  },
  "required": [
    "id",
    "productId",
    "amount",
    "currency",
    "active",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
