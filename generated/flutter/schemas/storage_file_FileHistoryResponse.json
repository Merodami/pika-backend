{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Paginated response",
  "type": "object",
  "properties": {
    "data": {
      "description": "Page items",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Universally Unique Identifier",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "fileKey": {
            "description": "Storage key/path",
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "fileSize": {
            "description": "Size in bytes",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "mimeType": {
            "type": "string"
          },
          "fileType": {
            "type": "string",
            "enum": ["image", "video", "document", "audio", "other"]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "uploaded",
              "processing",
              "processed",
              "failed",
              "deleted"
            ]
          },
          "provider": {
            "type": "string",
            "enum": ["awsS3", "local", "minio"]
          },
          "bucketName": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "uploadedAt": {
            "description": "ISO 8601 datetime with timezone",
            "type": "string"
          },
          "deletedAt": {
            "description": "ISO 8601 datetime with timezone",
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "error": {
            "type": "string"
          },
          "createdAt": {
            "description": "When the record was created",
            "type": "string"
          },
          "updatedAt": {
            "description": "When the record was last updated",
            "type": "string"
          }
        },
        "required": [
          "id",
          "userId",
          "fileKey",
          "fileName",
          "fileSize",
          "mimeType",
          "fileType",
          "status",
          "provider",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    },
    "pagination": {
      "type": "object",
      "properties": {
        "page": {
          "description": "Current page number",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "description": "Items per page",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "total": {
          "description": "Total number of items",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalPages": {
          "description": "Total number of pages",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hasNext": {
          "description": "Whether there is a next page",
          "type": "boolean"
        },
        "hasPrev": {
          "description": "Whether there is a previous page",
          "type": "boolean"
        }
      },
      "required": [
        "page",
        "limit",
        "total",
        "totalPages",
        "hasNext",
        "hasPrev"
      ],
      "additionalProperties": false
    }
  },
  "required": ["data", "pagination"],
  "additionalProperties": false
}
