{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "enum": [
        "ios",
        "android",
        "web",
        "desktop",
        "other"
      ]
    },
    "deviceId": {
      "type": "string"
    },
    "deviceName": {
      "type": "string"
    }
  },
  "required": [
    "token",
    "platform"
  ],
  "additionalProperties": false
}