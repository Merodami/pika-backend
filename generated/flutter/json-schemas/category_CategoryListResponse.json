{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Paginated response",
  "type": "object",
  "properties": {
    "data": {
      "description": "Page items",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Universally Unique Identifier",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
          },
          "nameKey": {
            "description": "Translation key for category name",
            "type": "string",
            "maxLength": 255
          },
          "descriptionKey": {
            "description": "Translation key for category description",
            "type": "string",
            "maxLength": 255
          },
          "icon": {
            "description": "Category icon identifier",
            "type": "string",
            "maxLength": 255
          },
          "parentId": {
            "description": "Parent category ID for hierarchical structure",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
          },
          "isActive": {
            "description": "Whether category is active",
            "default": true,
            "type": "boolean"
          },
          "sortOrder": {
            "description": "Sort order for display",
            "default": 0,
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "slug": {
            "description": "URL-friendly category identifier",
            "type": "string",
            "maxLength": 255
          },
          "level": {
            "description": "Hierarchy level (1 for root, 2+ for children)",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "path": {
            "description": "Hierarchical path using parent IDs",
            "type": "string"
          },
          "createdBy": {
            "description": "User who created the category",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
          },
          "updatedBy": {
            "description": "User who last updated the category",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
          },
          "createdAt": {
            "description": "When the record was created"
          },
          "updatedAt": {
            "description": "When the record was last updated"
          },
          "children": {
            "description": "Child categories for hierarchical display",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "description": "Universally Unique Identifier",
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
                },
                "nameKey": {
                  "description": "Translation key for category name",
                  "type": "string",
                  "maxLength": 255
                },
                "descriptionKey": {
                  "description": "Translation key for category description",
                  "type": "string",
                  "maxLength": 255
                },
                "icon": {
                  "description": "Category icon identifier",
                  "type": "string",
                  "maxLength": 255
                },
                "parentId": {
                  "description": "Parent category ID for hierarchical structure",
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
                },
                "isActive": {
                  "description": "Whether category is active",
                  "default": true,
                  "type": "boolean"
                },
                "sortOrder": {
                  "description": "Sort order for display",
                  "default": 0,
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "slug": {
                  "description": "URL-friendly category identifier",
                  "type": "string",
                  "maxLength": 255
                },
                "level": {
                  "description": "Hierarchy level (1 for root, 2+ for children)",
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "path": {
                  "description": "Hierarchical path using parent IDs",
                  "type": "string"
                },
                "createdBy": {
                  "description": "User who created the category",
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
                },
                "updatedBy": {
                  "description": "User who last updated the category",
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
                },
                "createdAt": {
                  "description": "When the record was created"
                },
                "updatedAt": {
                  "description": "When the record was last updated"
                }
              },
              "required": [
                "id",
                "nameKey",
                "isActive",
                "sortOrder",
                "slug",
                "level",
                "path",
                "createdBy",
                "createdAt",
                "updatedAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "nameKey",
          "isActive",
          "sortOrder",
          "slug",
          "level",
          "path",
          "createdBy",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    },
    "pagination": {
      "type": "object",
      "properties": {
        "page": {
          "description": "Current page number",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "description": "Items per page",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "total": {
          "description": "Total number of items",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalPages": {
          "description": "Total number of pages",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hasNext": {
          "description": "Whether there is a next page",
          "type": "boolean"
        },
        "hasPrev": {
          "description": "Whether there is a previous page",
          "type": "boolean"
        }
      },
      "required": [
        "page",
        "limit",
        "total",
        "totalPages",
        "hasNext",
        "hasPrev"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "data",
    "pagination"
  ],
  "additionalProperties": false
}