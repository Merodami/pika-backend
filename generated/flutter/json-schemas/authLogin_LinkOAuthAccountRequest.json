{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": ["local", "google", "facebook", "apple", "github", "microsoft"]
    },
    "redirectUri": {
      "description": "Redirect after linking",
      "type": "string",
      "format": "uri"
    }
  },
  "required": ["provider"],
  "additionalProperties": false
}
